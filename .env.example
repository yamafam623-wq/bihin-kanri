# --- データベース ---
DATABASE_URL="file:./dev.db"

# --- 管理者ログイン（社員マスタ・備品マスタの管理画面に入るための簡易パスワード） ---
ADMIN_PASSWORD="admin1234"

# --- メール送信（SMTP）設定 ---
# 開発時はMailtrap等のテスト用SMTPサーバーの値を設定してください
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="bihin-kanri@example.com"

# 在庫僅少通知の宛先（管理者メールアドレス、複数の場合はカンマ区切り）
ALERT_EMAILS="admin@example.com"

# 同一品目について再通知しない期間（時間単位）
LOW_STOCK_RENOTIFY_HOURS="24"
